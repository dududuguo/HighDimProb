#check (mul_sampleOuterProduct_apply A X k i j :
  (A * sampleOuterProduct X k) i j = sampleLeftAction A X k i * X j k)
#check (sampleOuterProduct_mul_apply X k B i j :
  (sampleOuterProduct X k * B) i j = X i k * sampleRightAction X k B j)
#check (mul_sampleOuterProduct_mul_apply A X k B i j :
  (A * sampleOuterProduct X k * B) i j =
    sampleLeftAction A X k i * sampleRightAction X k B j)
#check (mul_smul_sampleOuterProduct_mul_apply A X k B c i j :
  (A * (c • sampleOuterProduct X k) * B) i j =
    c * sampleLeftAction A X k i * sampleRightAction X k B j)
#check (sampleColumn_mul_weight_mul_sampleRow X k :
  sampleColumn X k * sampleWeightMatrix n * sampleRow X k =
    (1 / (n : Real)) • sampleOuterProduct X k)
