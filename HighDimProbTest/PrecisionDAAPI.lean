    (1 / (n : Real)) • sampleOuterProduct X k)
#check (leaveOneOutShrinkageResolvent X k lam : SquareMatrix d)
#check (sampleCovariance_apply X : ∀ i j,
  sampleCovariance X i j =
    (1 / (n : Real)) * Finset.univ.sum (fun l : Fin n => X i l * X j l))
#check (leaveOneOutSampleCovariance_apply X k : ∀ i j,
  leaveOneOutSampleCovariance X k i j =
    (1 / (n : Real)) * (Finset.univ.erase k).sum (fun l : Fin n => X i l * X j l))
#check (sampleCovariance_eq_leaveOneOut_add_sampleOuter X k :
  sampleCovariance X =
    leaveOneOutSampleCovariance X k + (1 / (n : Real)) • sampleOuterProduct X k)
#check (leaveOneOutSampleCovariance_sub_sampleCovariance_eq_neg_sampleOuter X k :
  leaveOneOutSampleCovariance X k - sampleCovariance X =
    (-(1 / (n : Real))) • sampleOuterProduct X k)
