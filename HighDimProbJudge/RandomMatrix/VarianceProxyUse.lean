example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A : HighDimProb.RandomMatrix Omega n n}
    (hInt : HighDimProb.IntegrableRandomMatrix P A)
    (hPSD : forall omega, HighDimProb.IsPSDMatrix (A omega)) :
    HighDimProb.IsPSDMatrix (HighDimProb.matrixExpect P A) := by
  exact HighDimProb.isPSDMatrix_matrixExpect_of_pointwise_isPSD hInt hPSD

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A B : HighDimProb.RandomMatrix Omega n n}
    (hIntA : HighDimProb.IntegrableRandomMatrix P A)
    (hIntB : HighDimProb.IntegrableRandomMatrix P B)
    (hLE : forall omega, HighDimProb.MatrixLE (A omega) (B omega)) :
    HighDimProb.MatrixLE
      (HighDimProb.matrixExpect P A) (HighDimProb.matrixExpect P B) := by
  exact HighDimProb.matrixExpect_matrixLE_of_pointwise_matrixLE
    hIntA hIntB hLE

example {n : Nat} (M : Matrix (Fin n) (Fin n) Real) :
    HighDimProb.MatrixLE M M := by
  exact HighDimProb.matrixLE_refl M

example {n : Nat} {M N K : Matrix (Fin n) (Fin n) Real}
    (hMN : HighDimProb.MatrixLE M N) (hNK : HighDimProb.MatrixLE N K) :
    HighDimProb.MatrixLE M K := by
  exact HighDimProb.matrixLE_trans hMN hNK

example {n : Nat} {M N K L : Matrix (Fin n) (Fin n) Real}
    (hMN : HighDimProb.MatrixLE M N) (hKL : HighDimProb.MatrixLE K L) :
    HighDimProb.MatrixLE (M + K) (N + L) := by
  exact HighDimProb.matrixLE_add hMN hKL

example {n : Nat} {M N : Matrix (Fin n) (Fin n) Real}
    {a : Real} (ha : 0 <= a) (hMN : HighDimProb.MatrixLE M N) :
    HighDimProb.MatrixLE (a •M) (a •N) := by
  exact HighDimProb.matrixLE_smul_of_nonneg ha hMN

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A B : HighDimProb.RandomMatrix Omega m n}
    (hIntA : HighDimProb.IntegrableRandomMatrix P A)
    (hIntB : HighDimProb.IntegrableRandomMatrix P B) :
    HighDimProb.IntegrableRandomMatrix P (fun omega => B omega - A omega) := by
  exact HighDimProb.integrableRandomMatrix_sub hIntA hIntB

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A B : HighDimProb.RandomMatrix Omega m n}
    (hIntA : HighDimProb.IntegrableRandomMatrix P A)
    (hIntB : HighDimProb.IntegrableRandomMatrix P B) :
    HighDimProb.matrixExpect P (fun omega => B omega - A omega) =
      HighDimProb.matrixExpect P B - HighDimProb.matrixExpect P A := by
  exact HighDimProb.matrixExpect_sub hIntA hIntB

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A B : HighDimProb.RandomMatrix Omega m n}
    (hIntA : HighDimProb.IntegrableRandomMatrix P A)
    (hIntB : HighDimProb.IntegrableRandomMatrix P B) :
    HighDimProb.IntegrableRandomMatrix P (fun omega => A omega + B omega) := by
  exact HighDimProb.integrableRandomMatrix_add hIntA hIntB

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A : HighDimProb.RandomMatrix Omega m n}
    (a : Real) (hIntA : HighDimProb.IntegrableRandomMatrix P A) :
    HighDimProb.IntegrableRandomMatrix P (fun omega => a •A omega) := by
  exact HighDimProb.integrableRandomMatrix_smul a hIntA

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat} :
    HighDimProb.IntegrableRandomMatrix P
      (fun _omega => (0 : Matrix (Fin m) (Fin n) Real)) := by
  exact HighDimProb.integrableRandomMatrix_zero

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} [MeasureTheory.IsFiniteMeasure P]
    {m n : Nat} (M : Matrix (Fin m) (Fin n) Real) :
    HighDimProb.IntegrableRandomMatrix P (fun _omega => M) := by
  exact HighDimProb.integrableRandomMatrix_const M

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A B : HighDimProb.RandomMatrix Omega m n}
    (hIntA : HighDimProb.IntegrableRandomMatrix P A)
    (hIntB : HighDimProb.IntegrableRandomMatrix P B) :
    HighDimProb.matrixExpect P (fun omega => A omega + B omega) =
      HighDimProb.matrixExpect P A + HighDimProb.matrixExpect P B := by
  exact HighDimProb.matrixExpect_add hIntA hIntB

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    {A : HighDimProb.RandomMatrix Omega m n}
    (a : Real) :
    HighDimProb.matrixExpect P (fun omega => a •A omega) =
      a •HighDimProb.matrixExpect P A := by
  exact HighDimProb.matrixExpect_smul a

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat} :
    HighDimProb.matrixExpect P
      (fun _omega => (0 : Matrix (Fin m) (Fin n) Real)) = 0 := by
  exact HighDimProb.matrixExpect_zero

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {m n : Nat}
    (M : Matrix (Fin m) (Fin n) Real) :
    HighDimProb.matrixExpect P (fun _omega => M) = (P.real Set.univ) •M := by
  exact HighDimProb.matrixExpect_const M

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} [MeasureTheory.IsProbabilityMeasure P]
    {m n : Nat} (M : Matrix (Fin m) (Fin n) Real) :
    HighDimProb.matrixExpect P (fun _omega => M) = M := by
  exact HighDimProb.matrixExpect_const_of_isProbabilityMeasure M

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} [MeasureTheory.IsProbabilityMeasure P]
    {n : Nat} :
    HighDimProb.matrixExpect P
      (fun _omega => (1 : Matrix (Fin n) (Fin n) Real)) = 1 := by
  exact HighDimProb.matrixExpect_one_of_isProbabilityMeasure

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A : HighDimProb.RandomMatrix Omega n n}
    (hA : HighDimProb.RandomSelfAdjointMatrix P A) :
    HighDimProb.IsSelfAdjointMatrix
      (HighDimProb.matrixSecondMoment P A) := by
  exact HighDimProb.isSelfAdjointMatrix_matrixSecondMoment hA

example {Omega : Type*} [MeasurableSpace Omega]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A : HighDimProb.RandomMatrix Omega n n}
    (hA : HighDimProb.RandomSelfAdjointMatrix P A)
    (hInt : HighDimProb.IntegrableRandomMatrix P (HighDimProb.randomMatrixSquare A)) :
    HighDimProb.IsPSDMatrix
      (HighDimProb.matrixSecondMoment P A) := by
  exact HighDimProb.isPSD_matrixSecondMoment_of_selfAdjoint hA hInt

example {n : Nat} {M : Matrix (Fin n) (Fin n) Real}
    (hM : HighDimProb.IsSelfAdjointMatrix M) :
    HighDimProb.IsPSDMatrix (HighDimProb.matrixSquare M) := by
  exact HighDimProb.isPSD_matrixSquare_of_selfAdjoint hM

example {Omega I : Type*} [MeasurableSpace Omega] [Fintype I]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A : I -> HighDimProb.RandomMatrix Omega n n}
    (hA : forall i, HighDimProb.RandomSelfAdjointMatrix P (A i)) :
    HighDimProb.IsSelfAdjointMatrix
      (HighDimProb.matrixVarianceProxy P A) := by
  exact HighDimProb.isSelfAdjointMatrix_matrixVarianceProxy P hA

example {Omega I : Type*} [MeasurableSpace Omega] [Fintype I]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    {A : I -> HighDimProb.RandomMatrix Omega n n}
    (hA : forall i, HighDimProb.RandomSelfAdjointMatrix P (A i))
    (hInt : forall i, HighDimProb.IntegrableRandomMatrix P
      (HighDimProb.randomMatrixSquare (A i))) :
    HighDimProb.IsPSDMatrix
      (HighDimProb.matrixVarianceProxy P A) := by
  exact HighDimProb.isPSD_matrixVarianceProxy_of_selfAdjoint P hA hInt

example {Omega I : Type*} [MeasurableSpace Omega] [Fintype I]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    (A : I -> HighDimProb.RandomMatrix Omega n n)
    (V : Matrix (Fin n) (Fin n) Real) : Prop :=
  HighDimProb.MatrixVarianceProxyUpperBound P A V

example {Omega I : Type*} [MeasurableSpace Omega] [Fintype I]
    {P : MeasureTheory.Measure Omega} {n : Nat}
    (A : I -> HighDimProb.RandomMatrix Omega n n)
    (sigma2 : Real) : Prop :=
  HighDimProb.MatrixVarianceProxyNormBound P A sigma2
