// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbAnalysisImports {
  rankdir=LR;
  label="HighDimProb Analysis imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_analysis_leaves {
    label="Leaves";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Analysis.RealInequalities" [label="Analysis.RealInequalities", color="#bab0ab", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_analysis_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Analysis" [label="Analysis", color="#bab0ab", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }

}
