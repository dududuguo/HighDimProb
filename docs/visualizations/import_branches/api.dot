// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbApiImports {
  rankdir=LR;
  label="HighDimProb API imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_api_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb" [label="HighDimProb", color="#444444", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
    "HighDimProb.Experimental" [label="Experimental", color="#444444", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }

}
