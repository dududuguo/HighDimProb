// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbLimittheoremsImports {
  rankdir=LR;
  label="HighDimProb LimitTheorems imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_limittheorems_finite_sample_vocabulary {
    label="Finite Sample Vocabulary";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.LimitTheorems.Assumptions" [label="LimitTheorems.Assumptions", color="#9c755f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.LimitTheorems.Basic" [label="LimitTheorems.Basic", color="#9c755f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_limittheorems_limit_statements {
    label="Limit Statements";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.LimitTheorems.WeakLaw" [label="LimitTheorems.WeakLaw", color="#9c755f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_limittheorems_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.LimitTheorems" [label="LimitTheorems", color="#9c755f", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Concentration.Chebyshev" [label="Concentration.Chebyshev", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Scalar" [label="Scalar", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.LimitTheorems.Assumptions" -> "HighDimProb.LimitTheorems.Basic";
  "HighDimProb.LimitTheorems.Basic" -> "HighDimProb.Scalar";
  "HighDimProb.LimitTheorems.WeakLaw" -> "HighDimProb.Concentration.Chebyshev";
  "HighDimProb.LimitTheorems.WeakLaw" -> "HighDimProb.LimitTheorems.Basic";
}
