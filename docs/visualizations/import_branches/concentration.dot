// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbConcentrationImports {
  rankdir=LR;
  label="HighDimProb Concentration imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_concentration_finite_sum_families {
    label="Finite Sum Families";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration.MaxScale" [label="Concentration.MaxScale", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.RademacherSums" [label="Concentration.RademacherSums", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.SubExponentialSums" [label="Concentration.SubExponentialSums", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.SubGaussianSums" [label="Concentration.SubGaussianSums", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_concentration_foundations {
    label="Foundations";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration.Basic" [label="Concentration.Basic", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.Chebyshev" [label="Concentration.Chebyshev", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.Markov" [label="Concentration.Markov", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_concentration_mgf_and_chernoff {
    label="MGF and Chernoff";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration.MGF" [label="Concentration.MGF", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_concentration_orlicz_and_tail_bridges {
    label="Orlicz and Tail Bridges";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration.LayerCake" [label="Concentration.LayerCake", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.MomentImplications" [label="Concentration.MomentImplications", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.OrliczToTail" [label="Concentration.OrliczToTail", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.TailToOrlicz" [label="Concentration.TailToOrlicz", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_concentration_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration" [label="Concentration", color="#f28e2b", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }

  subgraph cluster_concentration_theorem_families {
    label="Theorem Families";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Concentration.Bernstein" [label="Concentration.Bernstein", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.Hoeffding" [label="Concentration.Hoeffding", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Concentration.Implications" [label="Concentration.Implications", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Analysis.RealInequalities" [label="Analysis.RealInequalities", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Distributions.RademacherFamily" [label="Distributions.RademacherFamily", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Init" [label="Init", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Scalar" [label="Scalar", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Scalar.Variance" [label="Scalar.Variance", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.SubExponential" [label="SubExponential", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.SubGaussian" [label="SubGaussian", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.Concentration.Basic" -> "HighDimProb.Scalar";
  "HighDimProb.Concentration.Bernstein" -> "HighDimProb.Concentration.SubExponentialSums";
  "HighDimProb.Concentration.Chebyshev" -> "HighDimProb.Concentration.Basic";
  "HighDimProb.Concentration.Chebyshev" -> "HighDimProb.Scalar.Variance";
  "HighDimProb.Concentration.Hoeffding" -> "HighDimProb.Concentration.SubGaussianSums";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.Bernstein";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.Hoeffding";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.MGF";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.MomentImplications";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.OrliczToTail";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.RademacherSums";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.SubExponentialSums";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.SubGaussianSums";
  "HighDimProb.Concentration.Implications" -> "HighDimProb.Concentration.TailToOrlicz";
  "HighDimProb.Concentration.LayerCake" -> "HighDimProb.Concentration.TailToOrlicz";
  "HighDimProb.Concentration.MGF" -> "HighDimProb.Concentration.MomentImplications";
  "HighDimProb.Concentration.Markov" -> "HighDimProb.Concentration.Basic";
  "HighDimProb.Concentration.MaxScale" -> "HighDimProb.Init";
  "HighDimProb.Concentration.MomentImplications" -> "HighDimProb.Analysis.RealInequalities";
  "HighDimProb.Concentration.MomentImplications" -> "HighDimProb.Concentration.OrliczToTail";
  "HighDimProb.Concentration.MomentImplications" -> "HighDimProb.Concentration.TailToOrlicz";
  "HighDimProb.Concentration.OrliczToTail" -> "HighDimProb.Concentration.Markov";
  "HighDimProb.Concentration.OrliczToTail" -> "HighDimProb.SubExponential";
  "HighDimProb.Concentration.OrliczToTail" -> "HighDimProb.SubGaussian";
  "HighDimProb.Concentration.RademacherSums" -> "HighDimProb.Distributions.RademacherFamily";
  "HighDimProb.Concentration.SubExponentialSums" -> "HighDimProb.Concentration.MaxScale";
  "HighDimProb.Concentration.SubExponentialSums" -> "HighDimProb.Concentration.SubGaussianSums";
  "HighDimProb.Concentration.SubGaussianSums" -> "HighDimProb.Concentration.MGF";
  "HighDimProb.Concentration.TailToOrlicz" -> "HighDimProb.Concentration.OrliczToTail";
}
