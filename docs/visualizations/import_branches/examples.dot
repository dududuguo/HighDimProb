// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbExamplesImports {
  rankdir=LR;
  label="HighDimProb Examples imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_examples_leaves {
    label="Leaves";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Examples.BasicUsage" [label="Examples.BasicUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.NetsUsage" [label="Examples.NetsUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.OrliczUsage" [label="Examples.OrliczUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.RandomMatrixUsage" [label="Examples.RandomMatrixUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.RandomVariableUsage" [label="Examples.RandomVariableUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.RandomVectorUsage" [label="Examples.RandomVectorUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Examples.TailUsage" [label="Examples.TailUsage", color="#af7aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Distribution" [label="Distribution", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Expectation" [label="Expectation", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Nets" [label="Nets", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Orlicz" [label="Orlicz", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.ProbabilitySpace" [label="ProbabilitySpace", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomMatrix" [label="RandomMatrix", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomVector" [label="RandomVector", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Tail" [label="Tail", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.Examples.BasicUsage" -> "HighDimProb.ProbabilitySpace";
  "HighDimProb.Examples.NetsUsage" -> "HighDimProb.Nets";
  "HighDimProb.Examples.OrliczUsage" -> "HighDimProb.Orlicz";
  "HighDimProb.Examples.RandomMatrixUsage" -> "HighDimProb.RandomMatrix";
  "HighDimProb.Examples.RandomVariableUsage" -> "HighDimProb.Distribution";
  "HighDimProb.Examples.RandomVariableUsage" -> "HighDimProb.Expectation";
  "HighDimProb.Examples.RandomVectorUsage" -> "HighDimProb.RandomVector";
  "HighDimProb.Examples.TailUsage" -> "HighDimProb.Tail";
}
