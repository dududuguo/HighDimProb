// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbVectorImports {
  rankdir=LR;
  label="HighDimProb Vector imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_vector_applications {
    label="Applications";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.SignalRecovery" [label="SignalRecovery", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_vector_geometry_and_nets {
    label="Geometry and Nets";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.GaussianWidth" [label="GaussianWidth", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Geometry" [label="Geometry", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.MetricEntropy" [label="MetricEntropy", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.MetricEntropyStatements" [label="MetricEntropyStatements", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Nets" [label="Nets", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_vector_random_vector_core {
    label="Random Vector Core";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.RandomVector" [label="RandomVector", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_vector_random_vector_structure {
    label="Random Vector Structure";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Isotropic" [label="Isotropic", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.SubGaussianVector" [label="SubGaussianVector", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_vector_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Vector" [label="Vector", color="#76b7b2", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Basic" [label="Basic", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Covariance" [label="Covariance", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomProcess" [label="RandomProcess", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomVariable" [label="RandomVariable", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.SubGaussian" [label="SubGaussian", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.GaussianWidth" -> "HighDimProb.RandomProcess";
  "HighDimProb.Geometry" -> "HighDimProb.GaussianWidth";
  "HighDimProb.Geometry" -> "HighDimProb.MetricEntropy";
  "HighDimProb.Geometry" -> "HighDimProb.MetricEntropyStatements";
  "HighDimProb.Geometry" -> "HighDimProb.Nets";
  "HighDimProb.Isotropic" -> "HighDimProb.Covariance";
  "HighDimProb.MetricEntropy" -> "HighDimProb.Nets";
  "HighDimProb.MetricEntropyStatements" -> "HighDimProb.MetricEntropy";
  "HighDimProb.Nets" -> "HighDimProb.Basic";
  "HighDimProb.RandomVector" -> "HighDimProb.RandomVariable";
  "HighDimProb.SignalRecovery" -> "HighDimProb.Basic";
  "HighDimProb.SubGaussianVector" -> "HighDimProb.RandomVector";
  "HighDimProb.SubGaussianVector" -> "HighDimProb.SubGaussian";
}
