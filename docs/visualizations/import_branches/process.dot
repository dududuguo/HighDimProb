// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbProcessImports {
  rankdir=LR;
  label="HighDimProb Process imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_process_empirical_processes {
    label="Empirical Processes";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.EmpiricalProcess" [label="EmpiricalProcess", color="#edc948", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_process_stochastic_process_core {
    label="Stochastic Process Core";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.RandomProcess" [label="RandomProcess", color="#edc948", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_process_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Process" [label="Process", color="#edc948", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.RandomVariable" [label="RandomVariable", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.EmpiricalProcess" -> "HighDimProb.RandomProcess";
  "HighDimProb.RandomProcess" -> "HighDimProb.RandomVariable";
}
