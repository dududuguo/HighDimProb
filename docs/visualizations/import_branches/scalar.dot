// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbScalarImports {
  rankdir=LR;
  label="HighDimProb Scalar imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_scalar_leaves {
    label="Leaves";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Covariance" [label="Covariance", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Lp" [label="Lp", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Moment" [label="Moment", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Orlicz" [label="Orlicz", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.SubExponential" [label="SubExponential", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.SubGaussian" [label="SubGaussian", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_scalar_scalar_moments {
    label="Scalar Moments";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Scalar.Centering" [label="Scalar.Centering", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Scalar.Variance" [label="Scalar.Variance", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }

  subgraph cluster_scalar_surface_api {
    label="Surface/API";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Scalar" [label="Scalar", color="#59a14f", fontcolor="#222222", style="rounded,dashed,filled", fillcolor="#f8f8f8"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Expectation" [label="Expectation", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomVariable" [label="RandomVariable", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.RandomVector" [label="RandomVector", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
    "HighDimProb.Tail" [label="Tail", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.Covariance" -> "HighDimProb.RandomVector";
  "HighDimProb.Covariance" -> "HighDimProb.Scalar.Variance";
  "HighDimProb.Lp" -> "HighDimProb.RandomVariable";
  "HighDimProb.Moment" -> "HighDimProb.Lp";
  "HighDimProb.Orlicz" -> "HighDimProb.Moment";
  "HighDimProb.Scalar.Centering" -> "HighDimProb.Expectation";
  "HighDimProb.Scalar.Centering" -> "HighDimProb.Lp";
  "HighDimProb.Scalar.Variance" -> "HighDimProb.Scalar.Centering";
  "HighDimProb.SubExponential" -> "HighDimProb.Expectation";
  "HighDimProb.SubExponential" -> "HighDimProb.Orlicz";
  "HighDimProb.SubExponential" -> "HighDimProb.Tail";
  "HighDimProb.SubGaussian" -> "HighDimProb.Orlicz";
  "HighDimProb.SubGaussian" -> "HighDimProb.Tail";
}
