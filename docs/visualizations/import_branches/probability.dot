// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbProbabilityImports {
  rankdir=LR;
  label="HighDimProb Probability imports";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // Branch aggregate fan-out imports are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  subgraph cluster_probability_leaves {
    label="Leaves";
    color="#dddddd";
    penwidth=1;
    "HighDimProb.Basic" [label="Basic", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Distribution" [label="Distribution", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Expectation" [label="Expectation", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.ProbabilitySpace" [label="ProbabilitySpace", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.RandomVariable" [label="RandomVariable", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
    "HighDimProb.Tail" [label="Tail", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  }


  subgraph cluster_boundary {
    label="external branch imports";
    color="#cccccc";
    "HighDimProb.Init" [label="Init", color="#aaaaaa", fontcolor="#666666", style="rounded,dashed"];
  }

  "HighDimProb.Basic" -> "HighDimProb.Init";
  "HighDimProb.Distribution" -> "HighDimProb.RandomVariable";
  "HighDimProb.Expectation" -> "HighDimProb.RandomVariable";
  "HighDimProb.ProbabilitySpace" -> "HighDimProb.Basic";
  "HighDimProb.RandomVariable" -> "HighDimProb.ProbabilitySpace";
  "HighDimProb.Tail" -> "HighDimProb.RandomVariable";
}
