// Generated by scripts/visualize_imports.py.
// Direction: importer -> imported module.
digraph HighDimProbImportSummary {
  rankdir=LR;
  label="HighDimProb core branch import summary";
  labelloc=t;
  graph [fontname="Arial", fontsize=11, compound=true];
  node [shape=box, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#666666", arrowsize=0.7];

  // API aggregate fan-out and example modules are omitted here;
  // use import_graph.dot for the exact file-level import graph.

  "Analysis" [label="Analysis\n2 modules", color="#bab0ab", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Concentration" [label="Concentration\n16 modules", color="#f28e2b", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Core" [label="Core\n1 module", color="#6f6f6f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Distributions" [label="Distributions\n3 modules", color="#b07aa1", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Infrastructure" [label="Infrastructure\n1 module", color="#79706e", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "LimitTheorems" [label="LimitTheorems\n4 modules", color="#9c755f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Probability" [label="Probability\n6 modules", color="#4e79a7", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Process" [label="Process\n3 modules", color="#edc948", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "RandomMatrix" [label="RandomMatrix\n21 modules", color="#e15759", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Scalar" [label="Scalar\n9 modules", color="#59a14f", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Statements" [label="Statements\n2 modules", color="#8cd17d", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];
  "Vector" [label="Vector\n10 modules", color="#76b7b2", fontcolor="#222222", style="rounded,filled", fillcolor="#ffffff"];

  "Concentration" -> "Analysis";
  "Concentration" -> "Core";
  "Concentration" -> "Distributions";
  "Concentration" -> "Scalar";
  "Distributions" -> "Concentration";
  "Infrastructure" -> "Probability";
  "LimitTheorems" -> "Concentration";
  "LimitTheorems" -> "Scalar";
  "Probability" -> "Core";
  "Process" -> "Probability";
  "RandomMatrix" -> "Probability";
  "RandomMatrix" -> "Scalar";
  "RandomMatrix" -> "Vector";
  "Scalar" -> "Probability";
  "Scalar" -> "Vector";
  "Statements" -> "Probability";
  "Vector" -> "Probability";
  "Vector" -> "Process";
  "Vector" -> "Scalar";
}
